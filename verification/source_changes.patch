+@pytest.mark.parametrize("width_ghz,offset_ghz", [(5, 0), (5, 25), (25, 0), (25, 50)])
+def test_profiled_lines_with_filter_against_adaptive_quadrature(width_ghz, offset_ghz):
+    """Resolve a broad line overlapping a narrow accepted mode independently."""
+    from scipy.integrate import quad
+    mode = md.GaussianMode(193.4e12, 10e9)
+    filt = md.SuperGaussianFilter(mode.f0, 25e9, 4, 110.0,
+                                 (nm_to_hz(1600.0), nm_to_hz(1500.0)))
+    line = mode.f0 + offset_ghz * 1e9
+    width = width_ghz * 1e9
+    power = 1e-12
+
+    # Integrate the original densities over offset in GHz; no Gaussian-product
+    # reduction or Hermite nodes from the production implementation are used.
+    def integrand(offset):
+        f = mode.f0 + offset * 1e9
+        profile = np.exp(-0.5 * ((f - line) / width) ** 2) / (
+            np.sqrt(2 * np.pi) * width)
+        return 0.5 * power * profile * mode.intensity(f) * filt(f) / (
+            H_PLANCK * f) * 1e9
+
+    reference, error = quad(integrand, -100, 100, epsabs=1e-22,
+                            epsrel=1e-10, points=[-12.5, 0, 12.5])
+    actual = md.occupancy_from_profiled_lines(
+        mode, [power], [line], width, transfer_fn=filt, order=48)
+    assert error < 1e-8 * reference
+    assert actual == pytest.approx(reference, rel=2e-7, abs=0.0)
+
